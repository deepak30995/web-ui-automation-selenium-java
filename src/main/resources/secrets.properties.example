# ========================================
# LOCAL SECRETS - TEMPLATE
# ========================================
# Copy this file to secrets.properties in the same directory and fill in the values:
#
#     cp src/main/resources/secrets.properties.example src/main/resources/secrets.properties
#
# secrets.properties is git-ignored and must never be committed.
# Keys here match the ${PLACEHOLDER} names used in the config*.properties files.
#
# Resolution order: environment variable  ->  secrets.properties  ->  unresolved (warns)
# CI should set environment variables instead of shipping this file.

TEST_LEARNER_EMAIL=
TEST_LEARNER_PASSWORD=
