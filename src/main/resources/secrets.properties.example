# ========================================
# LOCAL SECRETS - TEMPLATE
# ========================================
# Copy this file to secrets.properties in the same directory and fill in the values:
#
#     cp src/main/resources/secrets.properties.example src/main/resources/secrets.properties
#
# secrets.properties is git-ignored and must never be committed.
# Keys here match the ${PLACEHOLDER} names used in the config*.properties files.
#
# Resolution order: -D property  ->  environment variable  ->  secrets.properties
# CI should set environment variables instead of shipping this file.
#
# Accounts and URLs are per target environment. Select one at runtime with
# -Dtarget.env=staging (default) or -Dtarget.env=prod.

# ---- Application under test ----
STAGING_BASE_URL=
PROD_BASE_URL=

# ---- Staging accounts ----
STAGING_USER_EMAIL=
STAGING_USER_PASSWORD=
STAGING_ADMIN_EMAIL=
STAGING_ADMIN_PASSWORD=
# Address deliberately not tied to any account, for negative login coverage
STAGING_INCORRECT_EMAIL=

# ---- Prod accounts ----
PROD_USER_EMAIL=
PROD_USER_PASSWORD=
PROD_ADMIN_EMAIL=
PROD_ADMIN_PASSWORD=
PROD_INCORRECT_EMAIL=

# ---- Execution platforms ----
# Only required for the platform you actually run against (-Dtest.env=browserstack etc.)
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
LAMBDATEST_USERNAME=
LAMBDATEST_ACCESS_KEY=
SAUCELABS_USERNAME=
SAUCELABS_ACCESS_KEY=
AWS_DEVICE_FARM_URL=
