<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">

<!-- Full coverage. Sequential by default.
     The framework is thread-safe (driver, page objects and the Extent node are all
     ThreadLocal), but parallel execution is not yet verified end to end on a real
     run, so opt in deliberately rather than by default:
         parallel="methods" thread-count="3"  -->
<suite name="Regression Run" verbose="1" parallel="methods" thread-count="3">

    <listeners>
        <!-- Applies RetryAnalyzer to every test, so new tests never miss it -->
        <listener class-name="listeners.RetryListener"/>
    </listeners>

    <test name="Regression test">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <!-- Scanned by package, so a new class tagged "regression" is picked up
             automatically - no class list to keep in sync. -->
        <packages>
            <package name="tests"/>
        </packages>
    </test>

</suite>
