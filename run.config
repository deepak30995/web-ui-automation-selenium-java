# ---------------------------------------------------------------------------
# Defaults for a scheduled/CI run. Single source of truth for run-suite.sh.
#
# Every value here is a DEFAULT ONLY: the environment wins. That is what keeps
# the pipeline portable - GitHub Actions, Jenkins, cron and a laptop all drive
# the same script by exporting these names, and none of them needs its own copy
# of the logic.
#
#   export SUITE_PROFILE=smoke BROWSER=firefox && ./run-suite.sh
# ---------------------------------------------------------------------------

# --- what to run -----------------------------------------------------------
SUITE_PROFILE="${SUITE_PROFILE:-regression}"   # smoke | sanity | regression | e2e
TARGET_ENV="${TARGET_ENV:-staging}"            # staging | prod        (site under test)
TEST_ENV="${TEST_ENV:-docker}"                 # local | docker | browserstack | lambdatest | saucelabs | aws
BROWSER="${BROWSER:-chrome}"                   # chrome | firefox | edge | safari

# Scheduled runs record video, and a recorder captures a real display - a
# headless browser draws nothing, so the file would be blank.
HEADLESS="${HEADLESS:-false}"

# --- grid ------------------------------------------------------------------
GRID_URL="${GRID_URL:-http://localhost:4444}"
GRID_READY_TIMEOUT="${GRID_READY_TIMEOUT:-120}"   # seconds to wait for the hub
MANAGE_GRID="${MANAGE_GRID:-auto}"                # auto | yes | no
                                                  # auto = manage it only when TEST_ENV=docker

# --- video -----------------------------------------------------------------
RECORD_VIDEO="${RECORD_VIDEO:-true}"

# --- retention -------------------------------------------------------------
# Whole runs are kept or dropped together. A report without its log and video
# is hard to act on, so pruning never splits a run apart.
RUNS_DIR="${RUNS_DIR:-test-output/runs}"
KEEP_RUNS="${KEEP_RUNS:-5}"

# --- agents ----------------------------------------------------------------
REVIEW_RUN="${REVIEW_RUN:-true}"     # Lead SDET reviews the finished run
AUTO_FIX="${AUTO_FIX:-false}"        # Senior SDET attempts STALE_LOCATOR fixes + PR

# --- email -----------------------------------------------------------------
# Credentials are never stored here. SMTP_HOST / SMTP_USER / SMTP_PASSWORD come
# from the environment (GitHub secrets, Jenkins credentials, or a local export).
SEND_EMAIL="${SEND_EMAIL:-false}"
EMAIL_TO="${EMAIL_TO:-}"
EMAIL_FROM="${EMAIL_FROM:-${SMTP_USER:-}}"
EMAIL_SUBJECT_PREFIX="${EMAIL_SUBJECT_PREFIX:-[UI Automation]}"
